# sc-voxel deployment environment — copy to .env and fill in.
# .env is gitignored. NEVER commit a private key. NEVER paste it into chat.
#
# IMPORTANT: use a DEDICATED development wallet, NOT a wallet that holds real
# mainnet funds. Celo Sepolia gas is paid with FREE testnet CELO from the faucet,
# so a real-money wallet is unnecessary and unsafe here.

# Deployer key for the dedicated dev wallet (with the 0x prefix).
PRIVATE_KEY=0xyour_dev_wallet_private_key_here

# RPC endpoints
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org   # chainId 11142220 (dev/QA)
CELO_RPC_URL=https://forno.celo.org                                # chainId 42220   (mainnet)

# Optional: contract source verification on Celoscan
CELOSCAN_API_KEY=
