# Copy to .env and fill in. .env is gitignored.

# RPC endpoint for Celo Mainnet (chainId 42220). Default forno is fine for low volume;
# for reliability under 100-wallet load consider a dedicated RPC (Infura/Ankr/QuickNode Celo).
RPC_URL=https://forno.celo.org

# Funder wallet that holds the test CELO. Used ONLY by distribute.js (one-time, local).
# This key moves real funds — keep it secret, never commit, never put in GitHub.
FUNDER_PRIVATE_KEY=0x

# How much native CELO to send to EACH of the 100 wallets (distribute.js).
# 100 wallets x 0.5 = 50 CELO total budget for the test.
FUND_PER_WALLET=0.5

# How much CELO each wallet deposits into the game -> VOXEL credits (deposit.js).
# 0.2 CELO x voxelPerCelo(1000) = 200 credits per wallet. Rest stays native for gas.
DEPOSIT_CELO=0.2

# Plays per wallet per bot run. Cron fires 2x/day, so 1 here = 2 plays/day total.
PLAYS_PER_RUN=1

# Game level: 1=beginner (fee 10), 2=medium (25), 3=hard (50).
LEVEL=1

# --- Deposit-spam mode (spam-deposit.js): cheapest tx volume (~6.5x less gas than play) ---
# Min deposit value (contract floor 0.001 CELO -> 1 credit). Value is recoverable via withdraw.
DEPOSIT_MIN=0.001
# Deposits per wallet per run. Cron 2x/day, so 1 here = 2 deposits/day/wallet.
DEPOSITS_PER_RUN=1

# Skip a wallet's play if its native balance drops below this (avoid stuck/failed tx).
MIN_GAS_RESERVE=0.02

# Parallel wallets in flight (RPC-friendly). 8 is safe for forno.
CONCURRENCY=8

# Number of wallets to generate (generate-wallets.js).
WALLET_COUNT=100
